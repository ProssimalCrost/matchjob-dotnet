# .env.example - Copie para .env e configure com seus valores

# ═══════════════════════════════════════════════════════════
# BANCO DE DADOS - SQL Server
# ═══════════════════════════════════════════════════════════
SQLSERVER_SA_PASSWORD=MatchJob@2024!
SQLSERVER_DATABASE=MatchJobDb
SQLSERVER_PORT=1433

# ═══════════════════════════════════════════════════════════
# REDIS - Cache
# ═══════════════════════════════════════════════════════════
REDIS_PORT=6379
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════
# Backend .NET 8
# ═══════════════════════════════════════════════════════════
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
DOTNET_USE_POLLING_FILE_WATCHER=0

# Connection Strings
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=MatchJobDb;User Id=sa;Password=MatchJob@2024!;TrustServerCertificate=True
ConnectionStrings__RedisConnection=redis:6379

# Supabase (Authentication)
Supabase__Url=https://your-project.supabase.co
Supabase__AnonKey=your-anon-key
Supabase__ServiceRoleKey=your-service-role-key

# JWT
JWT__Secret=your-jwt-secret-key-minimum-32-characters
JWT__Issuer=your-app-name
JWT__Audience=your-app-audience
JWT__ExpirationMinutes=60

# ═══════════════════════════════════════════════════════════
# Frontend Next.js
# ═══════════════════════════════════════════════════════════
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ═══════════════════════════════════════════════════════════
# Docker Compose
# ═══════════════════════════════════════════════════════════
COMPOSE_PROJECT_NAME=matchjob
COMPOSE_FILE=docker-compose.yml

# ═══════════════════════════════════════════════════════════
# DESENVOLVIMENTO (descomente se usar docker-compose.dev.yml)
# ═══════════════════════════════════════════════════════════
# ASPNETCORE_ENVIRONMENT=Development
# NODE_ENV=development
# DOTNET_USE_POLLING_FILE_WATCHER=1
